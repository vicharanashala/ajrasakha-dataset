# MongoDB connection (defaults are baked into the code, override here if needed).
# The URI includes credentials for a shared Atlas cluster. Rotate them in Atlas
# before sharing publicly.

MONGODB_URI=mongodb+srv://<>:<>
MONGODB_DB_NAME=<>

# HTTP server
PORT=3000

# Environment
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# Email Configuration (Zoho SMTP)
EMAIL_USER=abiramk@annam.ai
EMAIL_PASS=your-app-password
SMTP_FROM=Ajrasakha Dataset <noreply@ajrasakha.com>

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Base URL (required for Google OAuth in production - construct callback URL from this)
# For Cloud Run, set this to your production URL: https://your-service.run.app
BASE_URL=http://localhost:3000
