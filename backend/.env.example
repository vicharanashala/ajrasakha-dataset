# MongoDB connection (defaults are baked into the code, override here if needed).
# The URI includes credentials for a shared Atlas cluster. Rotate them in Atlas
# before sharing publicly.

MONGODB_URI=mongodb+srv://<>:<>
MONGODB_DB_NAME=<>

# HTTP server
PORT=3000

# Environment
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# SMTP Configuration (for email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=Ajrasakha Dataset <noreply@ajrasakha.com>
