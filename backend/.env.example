# MongoDB connection (defaults are baked into the code, override here if needed).
# The URI includes credentials for a shared Atlas cluster. Rotate them in Atlas
# before sharing publicly.

MONGODB_URI=mongodb+srv://<>:<>
MONGODB_DB_NAME=<>

# HTTP server
PORT=3000

# Environment
NODE_ENV=development

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production-minimum-32-chars
JWT_EXPIRES_IN=7d

# Email Configuration (Zoho SMTP)
EMAIL_USER=your-email@yourdomain.com
EMAIL_PASS=your-app-password
SMTP_FROM=Ajrasakha Dataset <noreply@ajrasakha.com>

